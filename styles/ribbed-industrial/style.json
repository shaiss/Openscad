{
  "schema": "stylelift/style@1",
  "name": "ribbed-industrial",
  "title": "Ribbed Industrial",
  "summary": "Finned utility housings on a 1 mm module: 5 mm ribs, a 1 mm break on every edge, and nothing that needs support.",
  "provenance": {
    "reference": [
      {
        "file": "compressor-box.stl",
        "sha256": "b33a17f369b5cc015c26a7e4266ef513637f959b6eb09f21b3de18b3c958d9e3",
        "source": "Clockspring3D '819 Compressor Box' (box + lid), supplied by the repo owner. Not redistributed; the sha256 below identifies it.",
        "license": "Personal use, no redistribution \u2014 reference measured locally, mesh never committed"
      },
      {
        "file": "compressor-box-lid.stl",
        "sha256": "61a32a87401bbb74eeba70848e26f69c27e4eb72db4f302839755ac1f365836f",
        "source": "Clockspring3D '819 Compressor Box' (box + lid), supplied by the repo owner. Not redistributed; the sha256 below identifies it.",
        "license": "Personal use, no redistribution \u2014 reference measured locally, mesh never committed"
      }
    ],
    "lifted_by": "stylelift",
    "primary": "compressor-box.stl",
    "others_measured": [
      {
        "file": "compressor-box-lid.stl",
        "softness": 0.7432,
        "dominant_r_mm": 1.0
      }
    ]
  },
  "tokens": {
    "corner_r": 4.0,
    "edge_chamfer": 1.0,
    "wall": 3.0,
    "fn": 64,
    "max_overhang_deg": 45,
    "rib_pitch": 5.0,
    "rib_depth": 1.0,
    "rib_crest": 1.0
  },
  "asserted": {
    "material": "opaque PLA or PETG; the reference is printed as a two-colour assembly, one colour per part, never one part in two colours",
    "finish": "printed as-is \u2014 layer lines are part of the look and run with the ribs",
    "suits": "shop and desk housings that get picked up: boxes, caddies, lidded containers, anything with a lid or a moving part",
    "non_goals": "not a display style. No supports, no sculpted relief, no text on visible faces, no fillet where a chamfer will do"
  },
  "rules": [
    {
      "id": "edge-break",
      "metric": "edges.chamfers.dominant_leg_mm",
      "op": "near",
      "value": 1.0,
      "tol": 0.3,
      "severity": "required",
      "when": {
        "metric": "edges.chamfers.count",
        "op": "min",
        "value": 1
      },
      "why": "every edge in this family is broken by the same 1 mm 45-degree cut. Length-weighted, the 1.0 mm leg carries 83% of the box's chamfer band length and is the lid's largest single size too; it also appears at 0.9958 mm on an unrelated design by the same hand. The +-30% band is set by what the metric actually reports rather than by the design intent: dominant_leg_mm is an unweighted median over every band, so the lid reads 1.2112 despite being a 1 mm part. Wide enough for that artifact, still narrow enough to reject a 0.6 mm-chamfer family"
    },
    {
      "id": "breaks-its-edges",
      "metric": "edges.chamfers.count",
      "op": "min",
      "value": 8,
      "severity": "required",
      "why": "a part with no 45-degree breaks at all is not in this family, whatever size its chamfers would have been; the reference carries 260 bands on the box and 291 on the lid, so 8 is a floor no real part in the style can fall below"
    },
    {
      "id": "support-free",
      "metric": "orientation.unsupported_share",
      "op": "max",
      "value": 0.1,
      "severity": "required",
      "why": "the discipline the whole style is built on: no downward surface sits shallower than 45 degrees. The box needs support on 0.66% of its surface and the lid on 6.93%, against a limit of 10% that leaves room for one honest bridge"
    },
    {
      "id": "chunky-sections",
      "metric": "walls.p05_mm",
      "op": "min",
      "value": 2.0,
      "severity": "required",
      "why": "nothing in this family is thin \u2014 the box's 5th-percentile section is 2.5 mm and the lid's 3.18 mm. Ribs read as machined only on a wall heavy enough to carry them"
    },
    {
      "id": "chamfer-grammar",
      "metric": "edges.grammar.chamfered_share",
      "op": "min",
      "value": 0.03,
      "severity": "advisory",
      "why": "this family cuts where other families fillet (5.6% of the box's shaped edge length, 11.5% of the lid's). A share of edge length, which falls as a part grows, so advisory"
    },
    {
      "id": "upright-walls",
      "metric": "orientation.vertical_share",
      "op": "min",
      "value": 0.3,
      "severity": "advisory",
      "why": "the form is made of upright walls meeting flat tops, not a sloping shell \u2014 57% of the box's surface is vertical and 35% of the lid's. Advisory because a lid is mostly lid"
    }
  ],
