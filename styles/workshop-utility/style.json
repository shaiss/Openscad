{
  "schema": "stylelift/style@1",
  "name": "workshop-utility",
  "title": "Workshop Utility",
  "summary": "Generously rounded utility parts with 45-degree bed chamfers and an M3 fastener vocabulary.",
  "provenance": {
    "reference": [
      {
        "file": "style-ref-workshop-utility.stl",
        "sha256": "d0ebb20bd12489b0eb8755f73ce21977a7174d712f5f6fcc2befd192d8740806",
        "source": "rendered in-repo: OPENSCADPATH=lib:. openscad -o build/style-ref-workshop-utility.stl -D '$fn=64' lib/printability-demo.scad",
        "license": "this repository (MIT)"
      }
    ],
    "lifted_by": "stylelift",
    "primary": "style-ref-workshop-utility.stl"
  },
  "tokens": {
    "corner_r": 4.0,
    "fn": 64,
    "edge_chamfer": 0.6,
    "softness": 0.79,
    "hole_d": 3.4
  },
  "asserted": {
    "material": "opaque PLA or PETG, one colour per part",
    "finish": "printed as-is: layer lines visible, no sanding or filler",
    "suits": "shop fixtures, mounts, organisers \u2014 parts that get bolted to something and handled daily",
    "non_goals": "not a display style: no thin decorative ribs, no text on visible faces, nothing that needs supports to print"
  },
  "rules": [
    {
      "id": "corner-radius",
      "metric": "edges.rounding.dominant_r_mm",
      "op": "near",
      "value": 4.0,
      "tol": 0.35,
      "severity": "required",
      "when": {
        "metric": "edges.rounding.dominant_share",
        "op": "min",
        "value": 0.12
      },
      "why": "the family reuses one radius (4 mm) on its rounded edges; a part that rounds at a different scale reads as a different family"
    },
    {
      "id": "curve-smoothness",
      "metric": "edges.rounding.implied_fn",
      "op": "min",
      "value": 44,
      "severity": "required",
      "when": {
        "metric": "edges.rounding.dominant_share",
        "op": "min",
        "value": 0.12
      },
      "why": "curves in this family are drawn at about $fn=64; visibly faceted curves break the family look"
    },
    {
      "id": "chamfer-size",
      "metric": "edges.chamfers.dominant_leg_mm",
      "op": "near",
      "value": 0.6,
      "tol": 0.4,
      "severity": "advisory",
      "when": {
        "metric": "edges.chamfers.count",
        "op": "min",
        "value": 1
      },
      "why": "chamfers in the reference are cut at about 0.6 mm"
    },
    {
      "id": "soft-edges",
      "metric": "edges.softness",
      "op": "min",
      "value": 0.474,
      "severity": "advisory",
      "why": "this is a soft family: most of its edge length curves rather than turning a corner (a share of edge length, which falls as a part grows at fixed radius \u2014 advisory so a big tray in this family is not failed for being big)"
    },
    {
      "id": "grammar-rounded",
      "metric": "edges.grammar.rounded_share",
      "op": "min",
      "value": 0.443,
      "severity": "advisory",
      "why": "the reference treats 74% of its shaped edge length as rounded; that is the family's dominant edge grammar (a share of edge length, which falls as a part grows at fixed radius \u2014 advisory so a big tray in this family is not failed for being big)"
    },
    {
      "id": "hole-vocabulary",
      "metric": "features.dominant_hole_d_mm",
      "op": "near",
      "value": 3.4,
      "tol": 0.12,
      "severity": "advisory",
      "when": {
        "metric": "features.hole_count",
        "op": "min",
        "value": 1
      },
      "why": "the family's fastener vocabulary is a 3.4 mm hole; mixing fastener sizes across a family is what makes a set of parts feel unrelated"
    }
  ],
